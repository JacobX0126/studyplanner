# Copy this file to `.env.local` and fill in the values from your own
# Supabase project (Dashboard -> Project Settings -> API).
#
# Both variables are exposed to the browser by design — Vite inlines anything
# prefixed with VITE_ into the built bundle. That is safe here because the anon
# (publishable) key only ever grants what Row Level Security allows.
#
# Never put a `service_role` / `sb_secret_` key in this project. It bypasses RLS
# entirely and must stay server-side.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
